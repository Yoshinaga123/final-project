########################################
# USI Bridge (sample configuration)
# Copy this file to .env and fill in values locally.
########################################

# Bridge server
USI_BRIDGE_HOST=127.0.0.1
USI_BRIDGE_PORT=8787
# Optional access token (set both here and when launching the bridge)
USI_BRIDGE_TOKEN=

# Engine think time per move (milliseconds)
MOVETIME_MS=2000

# On Linux we don’t autostart from Flask by default
USI_AUTOSTART=0

# Paths
# Absolute path to your local YaneuraOu engine binary (or a folder containing the binary)
USI_ENGINE_PATH=
# Python interpreter to run the bridge (python3 recommended on Linux)
PYTHON_EXE=python3

# Evaluation function (NNUE)
# Enable NNUE and set EvalDir to the folder that contains nn.bin (e.g., Suisho5)
USI_USE_NNUE=1
USI_EVAL_DIR=

# Extra engine-specific setoptions (comma separated), usually leave empty
USI_EXTRA_OPTIONS=

# Optional book settings (bridge also sets sane defaults)
# USI_OwnBook=false
# BookFile=no_book
